# Python bytecode -- regenerated on every run, never worth committing
__pycache__/
*.pyc

# Per-machine screen calibration and live runtime state. These hold pixel
# coordinates tied to one specific PC's monitor layout, plus in-progress
# match data -- committing them would overwrite another operator's
# calibration with yours.
ocr/*/valorant_state.json
ocr/*/freefire_state.json
ocr/*/moba_state.json

# Loadout crops captured during a match -- large, regenerated per event.
ocr/freefire/captures/

# Design sources (PSD) and the vMix template package. Kept on disk but out
# of git: they're ~29MB of files nothing loads at runtime, and this repo
# auto-deploys, so every push would ship them. The exported PNGs the
# overlays actually reference ARE committed.
*.psd
*.gtzip

# The relay's shared secret. This repo is PUBLIC and the config files
# above are committed, so a token written in one is a token anyone can
# read -- and the OCR role can write, not just read. Kept here instead,
# or in the RELAY_TOKEN environment variable.
ocr/.relay_token

# Rotated relay tokens, written for the operator. Never committed.
RELAY-SECRETS.txt

# Last known address of the relay, so a DNS outage at startup is not
# fatal. Describes one machine's network, not the project.
ocr/.dns_cache.json

# The glyph template library: pictures of this desk's own screen, learned
# from OCR and rebuilt by itself whenever it is missing. Machine- and
# resolution-specific, so committing one operator's copy would hand every
# other setup a library that matches nothing on their screen.
ocr/freefire/freefire_glyphs.npz

# The picture of the client's ELIMINATED banner, kept by calibrate.py at
# the moment the box was drawn. Like the glyph library above it, this is
# a photograph of one desk's screen at one resolution over one backdrop,
# so committing it would hand every other setup a reference that matches
# nothing they see.
ocr/freefire/freefire_banner_flag.png
